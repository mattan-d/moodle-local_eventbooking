<div class="card local-eventbooking-hero mb-4">
    {{#banner}}
    <div class="local-eventbooking-bannerwrap{{#logo}} is-logo{{/logo}}">
        <img class="local-eventbooking-banner" src="{{url}}" alt="{{alt}}">
    </div>
    {{/banner}}
    <div class="card-body local-eventbooking-hero-body">
        <div class="local-eventbooking-hero-heading">
            <h1 class="local-eventbooking-title">{{name}}</h1>
            <span class="local-eventbooking-hero-badge {{statusclass}}">{{badge}}</span>
        </div>
        {{#when}}
        <div class="local-eventbooking-hero-when">
            <span class="local-eventbooking-choice-date">
                <span class="local-eventbooking-choice-day">{{day}}</span>
                <span class="local-eventbooking-choice-month">{{month}}</span>
                {{#time}}<span class="local-eventbooking-choice-time" dir="ltr">{{time}}</span>{{/time}}
            </span>
            {{#until}}<span class="local-eventbooking-hero-until">{{until}}</span>{{/until}}
        </div>
        {{/when}}
        {{#haslocations}}
        <div class="local-eventbooking-locations">
            {{#locations}}
            <span class="local-eventbooking-hero-place">{{name}}</span>
            {{/locations}}
        </div>
        {{/haslocations}}
        {{#hasgallery}}
        <div class="local-eventbooking-gallery">
            {{#gallery}}
            <img src="{{url}}" alt="{{alt}}">
            {{/gallery}}
        </div>
        {{/hasgallery}}
        {{#intro}}
        <div class="local-eventbooking-intro">{{{.}}}</div>
        {{/intro}}
    </div>
    {{#marketing}}
    <div class="card-body border-top local-eventbooking-marketing">{{{.}}}</div>
    {{/marketing}}
</div>
