<div class="local-eventbooking-cards row">
    {{#events}}
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 local-eventbooking-card">
            {{#bannerurl}}
            <a href="{{url}}"><img class="card-img-top local-eventbooking-card-img" src="{{bannerurl}}" alt=""></a>
            {{/bannerurl}}
            <div class="card-body d-flex flex-column">
                <h3 class="h5 card-title"><a href="{{url}}">{{name}}</a></h3>
                <p class="text-muted mb-2">{{dates}}</p>
                {{#summary}}<p class="card-text">{{summary}}</p>{{/summary}}
                <div class="mt-auto d-flex justify-content-between align-items-center">
                    <span class="badge {{badgeclass}}">{{badge}}</span>
                    <span class="local-eventbooking-occupancy">{{occupancy}}</span>
                </div>
            </div>
        </div>
    </div>
    {{/events}}
</div>
